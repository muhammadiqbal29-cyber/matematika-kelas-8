# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# Firebase Console → Realtime Database (the URL shown at the top)
FIREBASE_DATABASE_URL=https://YOUR-DATABASE.REGION.firebasedatabase.app
# Use a long, unique password for /guru.html
TEACHER_DASHBOARD_PASSWORD=replace-with-a-long-random-password
